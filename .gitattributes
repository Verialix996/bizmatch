# Normalize line endings to LF in the repo for all text files
* text=auto eol=lf

# Explicitly declare common text files
*.js    text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.md    text eol=lf
*.sql   text eol=lf
*.txt   text eol=lf
*.env*  text eol=lf

# Binary files — no line ending conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.db    binary
