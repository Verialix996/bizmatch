{
  "expo": {
    "name": "BizMatch",
    "slug": "bizmatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bizmatch.app"
    },
    "android": {
      "package": "com.bizmatch.app"
    },
    "scheme": "bizmatch",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-video"
    ]
  }
}
