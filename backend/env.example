# Server
PORT=3000
NODE_ENV=development

# Supabase — Project Settings -> API (URL + publishable/anon key + secret/service_role key)
# and Project Settings -> Database -> Connection string (use the pooler URI, port 6543).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Google OAuth is configured in the Supabase dashboard
# (Authentication -> Providers -> Google), not read from env vars here.

# Gemini AI (feed ranking, deck review, AI compatibility score)
# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Frontend URL (for CORS + redirect after OAuth)
FRONTEND_URL=http://localhost:8081

# Backend public URL
BACKEND_URL=http://localhost:3000
