# Server
PORT=3000
NODE_ENV=development

# Supabase — Project Settings -> API (URL + publishable/anon key + secret/service_role key)
# and Project Settings -> Database -> Connection string (use the pooler URI, port 6543).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Google OAuth is now configured in the Supabase dashboard
# (Authentication -> Providers -> Google) rather than here — this app no
# longer talks to Google directly. Keep these only if still used elsewhere.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email (Gmail API — see docs/setup-google-email.md)
GMAIL_USER=your_gmail@gmail.com
GMAIL_REFRESH_TOKEN=your_refresh_token

# Cloudinary (file storage — see docs/setup-cloudinary.md)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Anthropic / Claude AI (feed ranking, deck review, AI compatibility score)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Frontend URL (for redirect after OAuth)
FRONTEND_URL=http://localhost:8081

# Backend public URL (used in email links)
BACKEND_URL=http://localhost:3000
